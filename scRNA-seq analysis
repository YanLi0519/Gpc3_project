#====================================================================================
ASPC_Dataset_subtype_Cellnum <- as.data.frame(table(ASPC@active.ident,ASPC$Dataset))
colnames(ASPC_Dataset_subtype_Cellnum) <- c("Subtype","Dataset","Cell_number")
ASPC_Dataset_subtype_Cellnum$Dataset <- factor(ASPC_Dataset_subtype_Cellnum$Dataset)

ASPC_Dataset_subtype_Fraction<- ASPC_Dataset_subtype_Cellnum %>% 
  dplyr::group_by (Dataset) %>% 
  dplyr::mutate(Fraction = round(Cell_number/sum(Cell_number),4))

# 转换Fraction为百分比
ASPC_Dataset_subtype_Fraction <- ASPC_Dataset_subtype_Fraction %>%
  mutate(Percentage = Fraction * 100) 
write.csv(ASPC_Dataset_subtype_Fraction, file = "ASPC_Dataset_subtype_Fraction.csv")


iWAT_DFAT_data <- ASPC_Dataset_subtype_Fraction %>%
  filter(Dataset == "iWAT_DFAT")
p = ggplot(iWAT_DFAT_data , aes(x=Dataset, y=Percentage, fill=Subtype)) + 
  geom_bar(stat="identity", position="stack", color="black", size=1) + 
  scale_y_continuous(expand = expansion(add = c(0, 0)), limits = c(0, 120), breaks=seq(0, 120, by=20)) +
  scale_x_discrete(expand = expansion(add = c(0.5, 0.5))) + 
  scale_fill_manual(values=Leah_5colors) + 
  theme_minimal() +
  theme(
    panel.grid.major = element_blank(), 
    panel.grid.minor = element_blank(), 
    axis.text.x = element_blank(), 
    axis.ticks.x = element_blank(),
    axis.title.x = element_blank(), 
    axis.line = element_line(colour = "black", size = 1), 
    plot.title = element_text(hjust = 0.5), 
    legend.position = "none", 
    axis.ticks = element_line(size = 1) 
  ) +
  labs(y = "Proportion (%)", x = "") + 
  ggtitle("iWAT_DFAT") 
ggsave("Proportion-iWAT_DFAT.pdf", p, width = 2, height = 6)
