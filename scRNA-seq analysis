Subtype_markers <- FindAllMarkers(ASPC, assay = "RNA", min.pct = 0.25, logfc.threshold = 0.25) %>% filter(p_val_adj < 0.05)
Subtype_markers <- Subtype_markers %>% mutate(pct_diff = abs(pct.1 - pct.2))
write.csv(Subtype_markers, file = "ASPC_Subtype_markers.csv") 

p = FeaturePlot(ASPC, "Pdgfra",cols = c("lightgrey", "#C8161D"), 
