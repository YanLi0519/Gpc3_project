#===============================================================================
# DFAT&SVF combined analysis - ASPC
#====================================================================================
ASPC <- NormalizeData(ASPC) %>% FindVariableFeatures() %>% ScaleData()
ASPC <- SCTransform(ASPC, method = "glmGamPoi", vars.to.regress = "percent.mt", verbose = FALSE)
ASPC <- RunPCA(ASPC)
ASPC <- RunHarmony(ASPC,group.by.vars = "Dataset")
ASPC <- RunUMAP(ASPC, dims = 1:30, reduction="harmony")
ASPC <- FindNeighbors(ASPC, dims = 1:30, reduction="harmony")

ASPC <- FindClusters(ASPC,algorithm = 1,resolution = 0.15, reduction.type = "harmony",verbose = T)
saveRDS(ASPC, "ASPC_5subtypes.rds")
#====================================================================================
Leah_5colors <- c("#ECB0C1","#DD6B7B","#F29A76","#FFDC91FF","#D4D3CA")
Seurat::DimPlot(ASPC, reduction = "umap", group.by = "seurat_clusters",
                    pt.size = 0.2, cols = Leah_5colors,
                    label = T, repel = T, label.box = F, label.size = 7, label.color = "black") +
  ggtitle("Cluster") + 
  theme(plot.title = element_text(size = 25), 
        legend.text = element_text(size = 15))  


ASPC <- RenameIdents(ASPC, `0` = "ASPC1", `1` = "ASPC2", `2` = "ASPC3",`3` = "ASPC4", `4` = "ASPC5")
ASPC$Subtype <- ASPC@active.ident
SubtypeRanks <- c("ASPC1", "ASPC2", "ASPC3", "ASPC4", "ASPC5")
SubtypecolorRanks <-  c("#ECB0C1","#DD6B7B","#F29A76","#FFDC91FF","#D4D3CA")
Idents(ASPC) <- factor(Idents(ASPC), levels= SubtypeRanks)
table(ASPC@active.ident)
saveRDS(ASPC, "ASPC_5subtypes(after_annotation).rds")

p = DimPlot(ASPC, reduction = "umap", group.by = "Subtype",
            pt.size = 0.2, cols = SubtypecolorRanks, label = FALSE) + 
  ggtitle("ASPC subtypes") +
  theme(plot.title = element_text(size = 25, hjust = 0.5),  
        legend.text = element_text(size = 15),
        legend.position = c(0.88, 0.088),  
        panel.border = element_rect(linetype = "solid", color = "black", size = 1),
        legend.box.background = element_blank(),
        legend.background = element_rect(fill = "transparent"),
        legend.key = element_rect(fill = "transparent", colour = NULL), 
        legend.margin = margin(t = 0, r = 0, b = 0, l = 0))
p
ggsave("UMAP_ASPC(after_annotation).pdf", p, width = 8.5, height = 8.5)

iWAT_DFAT_cells <- WhichCells(ASPC, expression = Dataset == "iWAT_DFAT")
