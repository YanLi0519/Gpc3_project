## persistent genes
get_persistent <- function(deg12, deg18, out_up, out_down) {
  up12 <- subset(deg12, Change == "up")$gene
  dn12 <- subset(deg12, Change == "down")$gene
  up18 <- subset(deg18, Change == "up")$gene
  dn18 <- subset(deg18, Change == "down")$gene
  
  up_p <- data.frame(gene = intersect(up12, up18))
  dn_p <- data.frame(gene = intersect(dn12, dn18))
  write.csv(up_p, out_up, row.names = FALSE)
  write.csv(dn_p, out_down, row.names = FALSE)
  list(up = up_p, down = dn_p)
}

