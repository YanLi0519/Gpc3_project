calc_cluster_fraction <- function(obj, group_var = "Diet") {
  df <- as.data.frame(table(Idents(obj), obj[[group_var]][,1]))
  colnames(df) <- c("Cell_type", group_var, "Cell_number")
  df %>%
    group_by(.data[[group_var]]) %>%
    mutate(Fraction = round(Cell_number / sum(Cell_number), 4)) %>%
    ungroup()
}

plot_pies_by_group <- function(df, group_var = "Diet", colors = Leah_color, out = "combined_pies.png") {
  groups <- unique(df[[group_var]])
  plots <- list()
  for (i in seq_along(groups)) {
    g <- groups[i]
    sub <- dplyr::filter(df, .data[[group_var]] == g)
    p <- ggplot(sub, aes(x=1, y=Fraction, fill=Cell_type)) +
      geom_bar(stat="identity", width=1, show.legend = (i == length(groups))) +
      coord_polar("y", start=0) +
      theme_void() +
      labs(title=g) +
      theme(plot.title = element_text(hjust=0.5),
            legend.position="bottom",
            legend.box="vertical",
            legend.direction="vertical")
    # colors: if you have exactly k cell types and want fixed mapping, set scale_fill_manual.
    plots[[g]] <- p
  }
  combined <- do.call(grid.arrange, c(plots, ncol = length(groups)))
  ggsave(out, plot = combined, width = 20, height = 5)
  combined
}

