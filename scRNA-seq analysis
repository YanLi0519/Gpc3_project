plot_heatmap_by_diet <- function(obj, genes, out_pdf, w=4, h=10) {
  obj_sub <- subset(obj, features = genes)
  avg <- AverageExpression(obj_sub, features = genes, group.by = "Diet")
  mat <- as.matrix(avg$RNA)
  p <- pheatmap(
    mat,
    scale = "row",
    color = colorRampPalette(c("#8B49F6","white","#EA3323"))(255),
    show_rownames = TRUE, show_colnames = TRUE,
    cluster_rows = FALSE, cluster_cols = FALSE,
    fontsize_row = 12, fontsize_col = 10, angle_col = 45
  )
  pdf(out_pdf, width = w, height = h)
  grid::grid.newpage(); grid::grid.draw(p$gtable)
  dev.off()
  invisible(p)
}

