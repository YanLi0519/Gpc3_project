## 13) DEGs: HFD vs CD (iWAT & eWAT)
## =========================
run_deg <- function(obj, ident1, ident2, out_csv) {
  Idents(obj) <- obj$Diet
  deg <- FindMarkers(obj, ident.1 = ident1, ident.2 = ident2,
                     assay="RNA", min.pct=0.25, logfc.threshold=0.25) %>%
    as.data.frame() %>%
    dplyr::filter(p_val_adj < 0.05) %>%
    tibble::rownames_to_column("gene") %>%
    mutate(Change = ifelse(avg_log2FC > 0, "up", "down"))
  deg <- setorderv(as.data.table(deg), c("avg_log2FC","pct.1","pct.2"), c(-1,1,-1))
  fwrite(deg, out_csv)
  as.data.frame(deg)
}

