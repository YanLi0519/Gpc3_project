## =========================
## 16) Percentage of expressing cells by Diet (NO 0/1 picking)
## =========================
calc_percent_expressing <- function(obj, genes, group_var="Diet", assay="RNA", slot="counts", out_csv="percent.csv") {
  obj_sub <- subset(obj, features = genes)
  counts <- GetAssayData(obj_sub, assay = assay, slot = slot)
  groups <- unique(obj_sub[[group_var]][,1])
  meta <- obj_sub[[group_var]][,1]
  names(meta) <- colnames(obj_sub)
  
  percent_mat <- matrix(NA, nrow=nrow(counts), ncol=length(groups),
                        dimnames=list(rownames(counts), groups))
  for (g in groups) {
    cells <- names(meta[meta == g])
    expr_n <- rowSums(counts[, cells, drop=FALSE] > 0)
    percent_mat[, g] <- expr_n / length(cells) * 100
  }
  df <- as.data.frame(percent_mat)
  write.csv(df, out_csv, row.names = TRUE)
  df
}

