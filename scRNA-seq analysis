# “表达细胞比例”统计（不创建0/1标签，只做表）
summarize_gene_expr_pct <- function(obj, gene="Gpc3", group_var="Diet", out_csv=NULL) {
  total <- table(obj[[group_var]][,1])
  dat <- FetchData(obj, vars=c(group_var, gene))
  dat_expr <- dat[dat[[gene]] > 0, , drop=FALSE]
  expr <- table(dat_expr[[group_var]])
  pct <- (expr / total[names(expr)]) * 100
  
  res <- data.frame(
    Group = names(total),
    TotalCells = as.numeric(total),
    ExprCells = as.numeric(expr[names(total)]),
    Percentage = as.numeric(pct[names(total)])
  )
  res$ExprCells[is.na(res$ExprCells)] <- 0
  res$Percentage[is.na(res$Percentage)] <- 0
  
  if (!is.null(out_csv)) write.csv(res, out_csv, row.names=FALSE)
  res
}

