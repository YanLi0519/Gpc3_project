# ---------------------------
# 1) Utility functions
# ---------------------------
assert_true <- function(cond, msg) if (!isTRUE(cond)) stop(msg)

save_pheatmap_pdf <- function(pheatmap_obj, filename, width=8, height=8) {
  pdf(filename, width = width, height = height)
  grid.newpage()
  grid.draw(pheatmap_obj$gtable)
  dev.off()
}

load_one_sample <- function(path, group_name) {
  assert_true(dir.exists(path), paste0("Data path not found: ", path))
  mat <- Read10X(path)
  obj <- CreateSeuratObject(mat, min.cells = 3)
  obj$Group <- group_name
  obj[["percent.mt"]] <- PercentageFeatureSet(obj, pattern = "^mt-")
  obj
}

qc_filter <- function(obj, qc) {
  subset(obj, subset = nFeature_RNA > qc$min_features &
           nFeature_RNA < qc$max_features &
           percent.mt < qc$max_mt)
}

basic_preprocess_harmony <- function(obj, group_var="Group") {
  obj <- NormalizeData(obj) %>% FindVariableFeatures() %>% ScaleData() %>% RunPCA()
  obj <- RunHarmony(obj, group.by.vars = group_var)
  obj
}

run_umap_cluster <- function(obj, dims, reduction="harmony", resolution=0.1, algorithm=1) {
  obj <- RunUMAP(obj, reduction = reduction, dims = dims)
  obj <- FindNeighbors(obj, reduction = reduction, dims = dims)
  obj <- FindClusters(obj, resolution = resolution, algorithm = algorithm)
  obj
}

featureplot_clean <- function(obj, gene, title, order=TRUE, pt.size=1,
                              cols=c("lightgrey","#921C12")) {
  FeaturePlot(obj, features = gene,
              cols = cols,
              keep.scale = "feature",
              pt.size = pt.size,
              order = order) +
    ggtitle(title) +
    labs(x="", y="") +
    theme(axis.text = element_blank(),
          axis.ticks = element_blank(),
          axis.line  = element_blank())
}

pieplot_proportion <- function(df_count, colors, title) {
  df <- df_count %>%
    group_by(Group) %>%
    mutate(Percent = Count / sum(Count) * 100)
  
  ggplot(df, aes(x="", y=Percent, fill=Subtype)) +
    geom_col(width=1, color="white") +
    coord_polar(theta="y") +
    facet_wrap(~Group) +
    scale_fill_manual(values = colors) +
    theme_void() +
    ggtitle(title) +
    theme(plot.title = element_text(hjust=0.5, size=16, face="bold"),
          strip.text = element_text(size=14, face="bold"),
          legend.title = element_text(size=13),
          legend.text  = element_text(size=12))
}

run_DE_GO_one_subset <- function(obj, subset_label, out_dir, orgdb=org.Mm.eg.db,
                                 min.pct=0.05, p_cut=0.05, showCategory=5) {
  dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
  
  Idents(obj) <- obj$Group
  assert_true(all(c("Control","Mutant") %in% unique(obj$Group)), paste0(subset_label, ": need Control & Mutant"))
  
  de <- FindMarkers(
    obj, ident.1="Mutant", ident.2="Control",
    test.use="wilcox", logfc.threshold=0, min.pct=min.pct
  ) %>%
    as.data.frame() %>%
    rownames_to_column("gene") %>%
    arrange(desc(avg_log2FC))
  
  write.csv(de, file.path(out_dir, paste0(subset_label, "_DE_Mutant_vs_Control.csv")), row.names=FALSE)
  
  mutant_up  <- de %>% filter(avg_log2FC > 0, p_val < p_cut) %>% pull(gene)
  control_up <- de %>% filter(avg_log2FC < 0, p_val < p_cut) %>% pull(gene)
  
  mut_entrez <- bitr(mutant_up,  fromType="SYMBOL", toType="ENTREZID", OrgDb=orgdb) %>% pull(ENTREZID)
  ctl_entrez <- bitr(control_up, fromType="SYMBOL", toType="ENTREZID", OrgDb=orgdb) %>% pull(ENTREZID)
  
  ego_mut <- enrichGO(mut_entrez, OrgDb=orgdb, keyType="ENTREZID", ont="BP",
                      pvalueCutoff=p_cut, qvalueCutoff=p_cut, pAdjustMethod="BH", readable=TRUE)
  ego_ctl <- enrichGO(ctl_entrez, OrgDb=orgdb, keyType="ENTREZID", ont="BP",
                      pvalueCutoff=p_cut, qvalueCutoff=p_cut, pAdjustMethod="BH", readable=TRUE)
  
  write.csv(as.data.frame(ego_mut), file.path(out_dir, paste0(subset_label, "_Mutant_GO_BP.csv")), row.names=FALSE)
  write.csv(as.data.frame(ego_ctl), file.path(out_dir, paste0(subset_label, "_Control_GO_BP.csv")), row.names=FALSE)
  
  p_mut <- dotplot(ego_mut, showCategory=showCategory) +
    ggtitle(paste0(subset_label, " Mutant-enriched GO BP")) +
    theme(plot.title = element_text(hjust=0.5))
  p_ctl <- dotplot(ego_ctl, showCategory=showCategory) +
    ggtitle(paste0(subset_label, " Control-enriched GO BP")) +
    theme(plot.title = element_text(hjust=0.5))
  
  ggsave(file.path(out_dir, paste0(subset_label, "_Mutant_GO_dotplot.pdf")), p_mut, width=10, height=3)
  ggsave(file.path(out_dir, paste0(subset_label, "_Control_GO_dotplot.pdf")), p_ctl, width=10, height=3)
  
  invisible(list(DE=de, GO_mut=ego_mut, GO_ctl=ego_ctl))
}

